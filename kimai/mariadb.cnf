# MariaDB settings for the database bundled with the Kimai app.
# Only Kimai, inside the same container, ever connects to it.

[mysqld]
datadir = /data/mysql
bind-address = 127.0.0.1
port = 3306

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Keep the memory footprint small enough for a Raspberry Pi. Kimai's
# database stays small even after years of time tracking.
innodb_buffer_pool_size = 64M
innodb_log_file_size = 32M
max_connections = 50
performance_schema = OFF
