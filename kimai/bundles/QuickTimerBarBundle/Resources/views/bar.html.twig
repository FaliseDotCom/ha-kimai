{% trans_default_domain 'timer_bar' %}
{% set running = timer_bar.running %}
{% set is_running = running is not empty %}
{% set new_entry = {
  description: '',
  projectId: timer_bar.defaultProjectId,
  activityId: timer_bar.defaultActivityId,
  tagIds: [],
  billableMode: 'auto'
} %}
<link rel="stylesheet" href="{{ path('timer_bar_asset', { 'name': 'timer-bar.css', 'v': timer_bar_version }) }}">
<script src="{{ path('timer_bar_asset', { 'name': 'timer-bar.js', 'v': timer_bar_version }) }}" defer></script>

{# The script restores the mode the user last chose. #}
<div class="card mb-3 timer-bar{% if is_running %} timer-bar-running{% endif %}" data-timer-bar data-mode="timer">
  {% if is_running %}
    {# Timer mode while a record runs: the running record, saved as it changes. #}
    <form method="post" action="{{ path('timer_bar_update') }}" class="card-body timer-bar-form"
      data-timer-bar-form data-state="running">
      <input type="hidden" name="_token" value="{{ csrf_token('timer_bar') }}">
      <input type="hidden" name="_target_path" value="{{ target_path }}">
      <input type="hidden" name="timesheet" value="{{ running.id }}">

      {{ include('@QuickTimerBar/_fields.html.twig', { entry: running }) }}

      <div class="timer-bar-times">
        <input type="date" name="date" class="form-control timer-bar-date" value="{{ running.beginDate }}"
          title="{{ 'timer_bar.date'|trans }}" aria-label="{{ 'timer_bar.date'|trans }}" required>
        <input type="text" name="begin_time" class="form-control timer-bar-time" value="{{ running.beginTime }}"
          data-timepicker="on" data-format="{{ timer_bar.timeFormat }}" placeholder="{{ 'timer_bar.begin'|trans }}"
          title="{{ 'timer_bar.begin'|trans }}" aria-label="{{ 'timer_bar.begin'|trans }}" autocomplete="off">
        <time class="timer-bar-elapsed" datetime="{{ running.begin }}" data-timer-bar-begin="{{ running.begin }}">0:00:00</time>
      </div>

      {{ include('@QuickTimerBar/_mode_switch.html.twig') }}

      <button type="submit" formaction="{{ path('timer_bar_stop') }}" class="btn btn-danger btn-icon timer-bar-button"
        title="{{ 'timer_bar.stop'|trans }}" aria-label="{{ 'timer_bar.stop'|trans }}" data-timer-bar-stop>
        <i class="{{ 'stop'|icon(true) }}"></i>
      </button>

      <p class="timer-bar-error text-danger" role="alert" data-timer-bar-error hidden></p>
    </form>
  {% endif %}

  {# Timer mode starts a record now; manual mode adds a finished one from its date and times. #}
  <form method="post" action="{{ path('timer_bar_start') }}" class="card-body timer-bar-form"
    data-timer-bar-form data-state="idle">
    <input type="hidden" name="_token" value="{{ csrf_token('timer_bar') }}">
    <input type="hidden" name="_target_path" value="{{ target_path }}">

    {{ include('@QuickTimerBar/_fields.html.twig', { entry: new_entry }) }}

    <div class="timer-bar-times" data-timer-bar-manual>
      <input type="date" name="date" class="form-control timer-bar-date" value="{{ timer_bar.today }}"
        title="{{ 'timer_bar.date'|trans }}" aria-label="{{ 'timer_bar.date'|trans }}" required>
      <input type="text" name="begin_time" class="form-control timer-bar-time"
        data-timepicker="on" data-format="{{ timer_bar.timeFormat }}" placeholder="{{ 'timer_bar.begin'|trans }}"
        title="{{ 'timer_bar.begin'|trans }}" aria-label="{{ 'timer_bar.begin'|trans }}" autocomplete="off" data-timer-bar-begin-time>
      <span class="timer-bar-time-separator" aria-hidden="true">&ndash;</span>
      <input type="text" name="end_time" class="form-control timer-bar-time"
        data-timepicker="on" data-format="{{ timer_bar.timeFormat }}" placeholder="{{ 'timer_bar.end'|trans }}"
        title="{{ 'timer_bar.end'|trans }}" aria-label="{{ 'timer_bar.end'|trans }}" autocomplete="off">
    </div>
    <span class="timer-bar-elapsed timer-bar-idle-clock" aria-hidden="true">0:00:00</span>

    {{ include('@QuickTimerBar/_mode_switch.html.twig') }}

    <button type="submit" class="btn btn-success btn-icon timer-bar-button" data-timer-bar-submit
      data-title-timer="{{ 'timer_bar.start'|trans }}" data-title-manual="{{ 'timer_bar.add'|trans }}"
      title="{{ 'timer_bar.start'|trans }}" aria-label="{{ 'timer_bar.start'|trans }}">
      <i class="{{ 'start'|icon(true) }}" data-timer-bar-icon="timer"></i>
      <i class="{{ 'create'|icon(true) }}" data-timer-bar-icon="manual" hidden></i>
    </button>

    <p class="timer-bar-error text-danger" role="alert" data-timer-bar-error hidden></p>
  </form>

  <datalist id="timer-bar-suggestions">
    {% for suggestion in timer_bar.suggestions %}
      <option value="{{ suggestion.description }}" label="{{ suggestion.projectName }}"></option>
    {% endfor %}
  </datalist>
  {% if timer_bar.quickCreate.project %}
    <datalist id="timer-bar-customers">
      {% for customer in timer_bar.quickCreate.customers %}
        <option value="{{ customer }}"></option>
      {% endfor %}
    </datalist>
  {% endif %}
  <script type="application/json" data-timer-bar-suggestions>{{ timer_bar.suggestions|json_encode|raw }}</script>

  {% if show_continue %}
    <form method="post" action="{{ path('timer_bar_continue') }}" hidden data-timer-bar-continue
      data-label-timer="{{ 'timer_bar.continue'|trans }}" data-label-manual="{{ 'timer_bar.copy'|trans }}"
      data-entry-url="{{ path('timer_bar_entry') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('timer_bar') }}">
      <input type="hidden" name="_target_path" value="{{ target_path }}">
      <input type="hidden" name="timesheet" value="" data-timer-bar-continue-id>
    </form>
  {% endif %}
</div>
