  },
  "type": "kimai-plugin",
  "version": "1.0.0",
  "keywords": [ "kimai", "kimai-plugin" ],
  "license": "MIT",
  "authors": [
    {
      "name": "Sander Falise"
    }
  ],
  "extra":
